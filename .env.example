# Local mode is the default. Vercel must use DATA_MODE=supabase.
# The app requires Node.js 22.13+; Vercel projects may select Node.js 24.
# No default password or real keys are shipped.
DATA_MODE=local
# Optional absolute directory; defaults to .data in the project directory.
STARS_DATA_DIR=
# Exact browser origin for mutations. Remote deployments must set the canonical HTTPS origin.
APP_ORIGIN=http://127.0.0.1:3000
UPLOAD_IMAGE_LIMIT_MB=10
UPLOAD_AUDIO_LIMIT_MB=50
UPLOAD_VIDEO_LIMIT_MB=100
# Cloud upload cap in MB. Must be greater than 0 and no more than 50.
CLOUD_UPLOAD_LIMIT_MB=50

# Cloud mode only: controlled Auth user + SQL profile allowlist, private-media bucket.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_OWNER_ID=
# Server-only visitor media proxy token; use a cryptographically random value
# with at least 32 bytes of entropy. Store its SHA-256 hex digest in Supabase.
# Never prefix with NEXT_PUBLIC_ or expose it to browsers, URLs, or logs.
PUBLIC_MEDIA_READ_TOKEN=
# No service_role/secret key is required by the running application.
