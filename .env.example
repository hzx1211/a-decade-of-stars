# Local mode is the default. No default password or real keys are shipped.
DATA_MODE=local
# Optional absolute directory; defaults to .data in the project directory.
STARS_DATA_DIR=
# Exact browser origin for mutations. Unset: strict local Host + listening port.
# Remote/reverse-proxy deployments must set their canonical HTTPS origin.
APP_ORIGIN=http://127.0.0.1:3000
UPLOAD_IMAGE_LIMIT_MB=10
UPLOAD_AUDIO_LIMIT_MB=50
UPLOAD_VIDEO_LIMIT_MB=100

# Cloud mode only: controlled Auth user + SQL profile allowlist, private-media bucket.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_OWNER_ID=
# No service_role/secret key is required by the running application.
