{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-test/types/**/*.ts",
    ".next-test/dev/types/**/*.ts",
    ".next-test-fan/types/**/*.ts",
    ".next-test-fan/dev/types/**/*.ts",
    ".next-test-archive/types/**/*.ts",
    ".next-test-archive/dev/types/**/*.ts",
    ".next-test-media/types/**/*.ts",
    ".next-test-media/dev/types/**/*.ts",
    ".next-test-starsea/types/**/*.ts",
    ".next-test-starsea/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".npm-cache",
    ".vercel",
    ".data",
    "output",
    ".next-test*",
    ".test-data",
    "test-results",
    "playwright-report"
  ]
}
